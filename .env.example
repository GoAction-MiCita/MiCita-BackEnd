# Copy to .env and fill in the values. .env is git-ignored.

# PostgreSQL
DB_NAME=micita
DB_USERNAME=micita
DB_PASSWORD=change-me
DB_PORT=5432

# JWT (HS256). The secret must be at least 32 bytes.
JWT_SECRET=change-me-to-a-random-secret-of-32-bytes-or-more
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ADMIN account seeded at startup
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=Change-me1!

# API
API_PORT=8080
# update: Hibernate creates/updates the tables. Use validate once the schema exists.
DDL_AUTO=update
